[general]
# A folder where vdirsyncer can store some metadata about each pair.
status_path = "~/.vdirsyncer/status/"
[pair personal_addressbook]
a = "personal_addressbook_local"
b = "personal_addressbook_remote"
collections = ["from a", "from b"]
metadata = ["displayname"]
conflict_resolution = "b wins"

[storage personal_addressbook_local]
type = "filesystem"
path = "~/.config/vdirsyncer/data/personal_addressbook_local"
fileext = ".vcf"

[storage personal_addressbook_remote]
type = "carddav"
auth =  "basic"
url = "https://cloud.faefox.dev/remote.php/dav/addressbooks/users/charlotte/contacts"
username = "charlotte"
